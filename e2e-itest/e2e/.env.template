# OpenAN 集成测试环境变量契约（模板）
# 使用方式：cp e2e/.env.template e2e/.env 后按环境填写真实值；.env 禁止提交仓库。
# 分组说明见《OpenAN Integration Testing Process and Framework》§6.6。

# ---------- 集群与部署 ----------
# Kubernetes 集群接入（在线 Helm 形态）
KUBECONFIG=
OPENAN_NAMESPACE=openan
# 部署形态：online-helm | offline-compose
DEPLOY_MODE=online-helm

# ---------- 被测服务地址 ----------
# 注册中心（Registry Center，HTTPS 默认 5000）
REGISTRY_CENTER_URL=https://127.0.0.1:5000
# mTLS 客户端证书（注册中心 owner 隔离/签名验证依赖）
REGISTRY_CLIENT_CERT=
REGISTRY_CLIENT_KEY=
REGISTRY_CA_CERT=
# jku 白名单开关校验用（注册中心 server.conf 的 jwk_allowlist）
REGISTRY_JWK_ALLOWLIST=
# 编排中心（Orchestration Center，后端 5001 / 前端 3003）
ORCHESTRATION_CENTER_URL=http://127.0.0.1:5001
ORCH_ACCESS_PASSWORD=
# OpenAN Portal（Showroom/Playground）
OPENAN_PORTAL_URL=

# ---------- LLM 依赖（注册中心语义检索、编排中心意图/工作流生成） ----------
# 真实 LLM 端点（models.yaml + 命名密钥注入），或下方 mock 开关
LLM_CHAT_API_KEY=
LLM_CHAT_BASE_URL=
LLM_CHAT_MODEL=
# A2A-T SDK 独立 LLM 配置（orchestration-center .env 的 A2AT_LLM_*）
A2AT_LLM_PROVIDER=openai
A2AT_LLM_MODEL=
A2AT_LLM_API_KEY=
A2AT_LLM_BASE_URL=
# 测试确定性开关：true 时用 mock LLM / 桩响应
USE_MOCK_LLM=false

# ---------- 样例 / Mock Agent ----------
# openan-demo mockagent 或编排中心 samples 提供的样例 Agent 地址
MOCK_AGENTS_HOST=
SAMPLE_AGENTS_HOST=

# ---------- 外部数据库（部署 values 中的外部 MySQL/PostgreSQL） ----------
DB_BACKEND=postgresql
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=

# ---------- 镜像与制品 ----------
IMAGE_REGISTRY=ghcr.io/project-openan
IMAGE_TAG=
# 制品完整性校验（SBOM / 镜像 digest）
OPENAN_SBOM_PATH=

# ---------- 执行与报告 ----------
# 失败现场保留目录（trace/log/截图）
EVIDENCE_DIR=evidence
